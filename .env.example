# Copia este archivo como .env y ajusta los valores.

# Base de datos local (SQLite). Para producción usa PostgreSQL.
DATABASE_URL="file:./dev.db"

# Secreto de NextAuth. Genera uno con: openssl rand -base64 32
AUTH_SECRET="cambia-este-valor"

# Prefijo público cuando la app no vive en la raíz del dominio (ej. /didi2).
# Déjalo vacío si se publica en la raíz.
NEXT_PUBLIC_BASE_PATH=""

# URL pública de la app (sin /api/auth) y endpoint de autenticación.
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000/api/auth"
